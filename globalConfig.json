{
    "pages": {
        "configuration": {
            "tabs": [
                {
                    "name": "account",
                    "table": {
                        "actions": [
                            "edit",
                            "delete",
                            "clone"
                        ],
                        "header": [
                            {
                                "label": "Name",
                                "field": "name"
                            }
                        ]
                    },
                    "entity": [
                        {
                            "type": "text",
                            "label": "Name",
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Account Name must begin with a letter and consist exclusively of alphanumeric characters and underscores.",
                                    "pattern": "^[a-zA-Z]\\w*$"
                                },
                                {
                                    "type": "string",
                                    "errorMsg": "Length of input name should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ],
                            "field": "name",
                            "help": "A unique name for the account.",
                            "required": true
                        },
                        {
                            "type": "text",
                            "label": "OpenAI API Key",
                            "field": "api_key",
                            "help": "Your OpenAI API key for authentication. This will be stored securely and encrypted.",
                            "required": true,
                            "encrypted": true,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "API key is required and must be between 1 and 200 characters",
                                    "minLength": 1,
                                    "maxLength": 200
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "Organization ID",
                            "field": "organization_id",
                            "help": "Optional OpenAI Organization ID. Leave empty if not using organizations.",
                            "required": false,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Organization ID should be between 1 and 100 characters",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ]
                        }
                    ],
                    "title": "Accounts"
                },
                {
                    "type": "proxyTab"
                },
                {
                    "type": "loggingTab"
                }
            ],
            "title": "Configuration",
            "description": "Set up your add-on"
        },
        "inputs": {
            "services": [
                {
                    "name": "openai_usage",
                    "entity": [
                        {
                            "type": "text",
                            "label": "Name",
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Input Name must begin with a letter and consist exclusively of alphanumeric characters and underscores.",
                                    "pattern": "^[a-zA-Z]\\w*$"
                                },
                                {
                                    "type": "string",
                                    "errorMsg": "Length of input name should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ],
                            "field": "name",
                            "help": "A unique name for the data input.",
                            "required": true
                        },
                        {
                            "type": "interval",
                            "label": "Interval",
                            "defaultValue": "3600",
                            "field": "interval",
                            "options": {
                                "range": [
                                    300,
                                    86400
                                ]
                            },
                            "help": "Time interval for polling OpenAI usage data, in seconds. Default: 3600 (1 hour). Range: 300 (5 minutes) to 86400 (24 hours).",
                            "required": true
                        },
                        {
                            "type": "index",
                            "field": "index",
                            "label": "Index",
                            "defaultValue": "main",
                            "required": true,
                            "help": "Splunk index where OpenAI usage data will be stored."
                        },
                        {
                            "type": "singleSelect",
                            "label": "Account to use",
                            "options": {
                                "referenceName": "account"
                            },
                            "help": "Select the OpenAI account configured in the Account tab.",
                            "field": "account",
                            "required": true,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of account name should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "Start Date",
                            "field": "start_date",
                            "help": "Optional start date for collecting usage data in YYYY-MM-DD format. If not specified, collects data from the last polling interval.",
                            "required": false,
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Start date must be in YYYY-MM-DD format (e.g., 2024-01-15)",
                                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "Models",
                            "field": "models",
                            "help": "Optional. Comma-separated model IDs to restrict collection to, e.g. gpt-4o, o3, text-embedding-3-small. Leave empty to collect every model, which is the recommended setting: an allowlist silently omits any model it does not name, so usage of a newly released model would not appear in your cost data. Sent to the API as its models filter; endpoints without a model dimension ignore it.",
                            "required": false,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Models must be 0 to 2000 characters",
                                    "minLength": 0,
                                    "maxLength": 2000
                                }
                            ]
                        },
                        {
                            "type": "multipleSelect",
                            "label": "Attribution Dimensions",
                            "field": "group_by",
                            "help": "Break usage down by these dimensions in addition to model. These are the only handles OpenAI exposes for attributing spend to something inside your organisation, so what you can answer later depends on how projects and keys are provisioned now. Each dimension multiplies the number of records returned. Dimensions an endpoint does not support are skipped for that endpoint.",
                            "required": false,
                            "options": {
                                "delimiter": ",",
                                "items": [
                                    {
                                        "value": "project_id",
                                        "label": "Project"
                                    },
                                    {
                                        "value": "user_id",
                                        "label": "User"
                                    },
                                    {
                                        "value": "api_key_id",
                                        "label": "API Key"
                                    },
                                    {
                                        "value": "vector_store_id",
                                        "label": "Vector Store (file search only)"
                                    }
                                ]
                            }
                        }
                    ],
                    "inputHelperModule": "openai_usage_helper",
                    "title": "openai_usage"
                }
            ],
            "title": "Inputs",
            "description": "Manage your data inputs",
            "table": {
                "actions": [
                    "edit",
                    "delete",
                    "clone"
                ],
                "header": [
                    {
                        "label": "Name",
                        "field": "name"
                    },
                    {
                        "label": "Interval",
                        "field": "interval"
                    },
                    {
                        "label": "Index",
                        "field": "index"
                    },
                    {
                        "label": "Account",
                        "field": "account"
                    },
                    {
                        "label": "Status",
                        "field": "disabled"
                    }
                ],
                "moreInfo": [
                    {
                        "label": "Name",
                        "field": "name"
                    },
                    {
                        "label": "Interval",
                        "field": "interval"
                    },
                    {
                        "label": "Index",
                        "field": "index"
                    },
                    {
                        "label": "Account",
                        "field": "account"
                    },
                    {
                        "label": "Models",
                        "field": "models"
                    },
                    {
                        "label": "Start Date",
                        "field": "start_date"
                    },
                    {
                        "label": "Status",
                        "field": "disabled",
                        "mapping": {
                            "true": "Inactive",
                            "false": "Active"
                        }
                    }
                ]
            }
        },
        "dashboard": {
            "panels": [
                {
                    "name": "default"
                }
            ]
        }
    },
    "meta": {
        "name": "TA-openai-usage",
        "restRoot": "TA-openai-usage",
        "version": "1.1.0",
        "displayName": "OpenAI API Usage Monitor",
        "schemaVersion": "0.0.10",
        "supportedThemes": [
            "light",
            "dark"
        ]
    }
}
